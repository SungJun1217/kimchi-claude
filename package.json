{
  "name": "kimchi-claude",
  "version": "0.13.4",
  "private": true,
  "type": "module",
  "description": "한국어로 물으면 한국 개발자가 실제로 쓰는 말투로 답하는 클로드 코드 플러그인",
  "scripts": {
    "build": "node scripts/build-style.mjs",
    "art": "node scripts/build-readme-art.mjs",
    "test": "node scripts/build-style.mjs --check && node --test \"tests/*.test.mjs\"",
    "score": "node scripts/score-response.mjs",
    "eval": "claude plugin eval . --runs 2 -j 4"
  }
}
